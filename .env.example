# Environment Variables

# Database
DATABASE_URL=your_database_url_here

# Auth.js (next-auth v5) - required. Signs/encrypts session cookies.
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=your_auth_secret_here
# Only needed when not on localhost / Vercel (e.g. behind a proxy): set to the public origin
# AUTH_URL=http://localhost:3000
# Self-hosted production behind a proxy (not Vercel) also needs:
# AUTH_TRUST_HOST=true

# Supabase (Optional - if using Supabase)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
